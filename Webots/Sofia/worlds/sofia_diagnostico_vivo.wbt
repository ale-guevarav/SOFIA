#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "../protos/sofia.proto"

WorldInfo {
  basicTimeStep 8
  coordinateSystem "ENU"
}

Viewpoint {
  position 0.9 0.9 0.9
  orientation -0.35 0.65 0.7 1.5
  fieldOfView 0.9
}

TexturedBackground {}
TexturedBackgroundLight {}

Solid {
  translation 0 0 -0.005
  children [
    Shape {
      appearance DEF SUELO_APARIENCIA PBRAppearance { baseColor 0.25 0.25 0.27 roughness 1 }
      geometry Box { size 1 1 0.01 }
    }
  ]
  name "Suelo"
  boundingObject Box { size 1 1 0.01 }
}

# 16 unidades SOFIA (PROTO de protos/sofia.proto, del repo sofia-maquinas-estado).
# El origen de cada unidad está en el piso; la placa queda a ~59 mm.
# Separación mínima sin choques con TODAS las placas en su tope (±30°),
# medida sobre las mallas del PROTO: 140 mm entre vecinas de la misma
# fila y 116 mm entre filas (135.5 mm en diagonal), con ~3 mm de margen.
# Motores: joint_1 (eje X) = theta_1; joint_3 (eje Y, lleva la placa) = theta_2;
# joint_2 es la segunda biela y recibe el mismo ángulo que joint_3.
DEF PANEL_0_0 sofia { translation -0.174 -0.210 0 name "Panel_0_0" colorPlaca 0.92 0.92 0.92 controller "panel_dataset" supervisor TRUE }
DEF PANEL_0_1 sofia { translation -0.174 -0.070 0 name "Panel_0_1" colorPlaca 0.92 0.92 0.92 controller "panel_dataset" supervisor TRUE }
DEF PANEL_0_2 sofia { translation -0.174 0.070 0 name "Panel_0_2" colorPlaca 0.92 0.92 0.92 controller "panel_dataset" supervisor TRUE }
DEF PANEL_0_3 sofia { translation -0.174 0.210 0 name "Panel_0_3" colorPlaca 0.92 0.92 0.92 controller "panel_dataset" supervisor TRUE }
DEF PANEL_1_0 sofia { translation -0.058 -0.140 0 name "Panel_1_0" colorPlaca 0.92 0.92 0.92 controller "panel_dataset" supervisor TRUE }
DEF PANEL_1_1 sofia { translation -0.058 0.000 0 name "Panel_1_1" colorPlaca 0.92 0.92 0.92 controller "panel_dataset" supervisor TRUE }
DEF PANEL_1_2 sofia { translation -0.058 0.140 0 name "Panel_1_2" colorPlaca 0.92 0.92 0.92 controller "panel_dataset" supervisor TRUE }
DEF PANEL_1_3 sofia { translation -0.058 0.280 0 name "Panel_1_3" colorPlaca 0.92 0.92 0.92 controller "panel_dataset" supervisor TRUE }
DEF PANEL_2_0 sofia { translation 0.058 -0.210 0 name "Panel_2_0" colorPlaca 0.92 0.92 0.92 controller "panel_dataset" supervisor TRUE }
DEF PANEL_2_1 sofia { translation 0.058 -0.070 0 name "Panel_2_1" colorPlaca 0.92 0.92 0.92 controller "panel_dataset" supervisor TRUE }
DEF PANEL_2_2 sofia { translation 0.058 0.070 0 name "Panel_2_2" colorPlaca 0.92 0.92 0.92 controller "panel_dataset" supervisor TRUE }
DEF PANEL_2_3 sofia { translation 0.058 0.210 0 name "Panel_2_3" colorPlaca 0.92 0.92 0.92 controller "panel_dataset" supervisor TRUE }
DEF PANEL_3_0 sofia { translation 0.174 -0.140 0 name "Panel_3_0" colorPlaca 0.92 0.92 0.92 controller "panel_dataset" supervisor TRUE }
DEF PANEL_3_1 sofia { translation 0.174 0.000 0 name "Panel_3_1" colorPlaca 0.92 0.92 0.92 controller "panel_dataset" supervisor TRUE }
DEF PANEL_3_2 sofia { translation 0.174 0.140 0 name "Panel_3_2" colorPlaca 0.92 0.92 0.92 controller "panel_dataset" supervisor TRUE }
DEF PANEL_3_3 sofia { translation 0.174 0.280 0 name "Panel_3_3" colorPlaca 0.92 0.92 0.92 controller "panel_dataset" supervisor TRUE }


# =============================================
# DATASET DEL DIAGNÓSTICO DE ALINEACIÓN
# (generado por Alignment/build/herramientas/crear_mundo_dataset.py)
# =============================================

DEF LUZ_DIRECCIONAL DirectionalLight {
  direction -1 -1 -1
  intensity 1
  castShadows TRUE
}

DEF LUZ_PUNTUAL PointLight {
  location 0.3 0.3 0.5
  intensity 2
  attenuation 0 0 1
}

# Marco: 4 marcadores ArUco a la altura de las placas
Solid {
  translation 0.3000 0.3350 0.0580
  children [
    Shape {
      appearance PBRAppearance {
        baseColorMap ImageTexture { url [ "textures/aruco_0.png" ] filtering 0 }
        roughness 1
        metalness 0
      }
      geometry Box { size 0.080 0.080 0.002 }
    }
    Transform {
      translation 0 0 -0.0290
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.3 0.3 0.3 roughness 1 metalness 0 }
          geometry Box { size 0.02 0.02 0.0560 }
        }
      ]
    }
  ]
  name "aruco_0"
}

