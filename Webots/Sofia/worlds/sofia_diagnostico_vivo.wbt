# Cámara del dataset + supervisor que genera las fotos.
# Mira hacia abajo: arriba de la imagen = +X del mundo, derecha = -Y.
DEF GENERADOR Robot {
  translation 0.0 0.035 1.35
  rotation 0 1 0 1.5708
  name "diagnostico_vivo"
  controller "diagnostico_vivo"
  supervisor TRUE
  children [
    Camera {
      name "camara"
      fieldOfView 1.0
      width 1280
      height 1280
    }
  ]
}
