#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "../protos/sofia.proto"

WorldInfo {
  basicTimeStep 8
  coordinateSystem "ENU"
}

Viewpoint {
  position 0.9 0.9 0.9
  orientation -0.35 0.65 0.7 1.5
  fieldOfView 0.9
}

TexturedBackground {}
TexturedBackgroundLight {}

Solid {
  translation 0 0 -0.005
  children [
    Shape {
      appearance DEF SUELO_APARIENCIA PBRAppearance { baseColor 0.25 0.25 0.27 roughness 1 }
      geometry Box { size 1 1 0.01 }
    }
  ]
  name "Suelo"
  boundingObject Box { size 1 1 0.01 }
}

# 16 unidades SOFIA (PROTO de protos/sofia.proto, del repo sofia-maquinas-estado).
# El origen de cada unidad está en el piso; la placa queda a ~59 mm.
# Arreglo tipo panal con las medidas del robot real: 30 mm entre aristas
# a cualquier vecino -> 134 mm entre centros en la fila, filas a 116 mm
# y las filas impares desplazadas 67 mm. El PROTO es 1 a 1 con la unidad
# real (104 mm de lado a lado de la placa).
DEF PANEL_0_0 sofia { translation -0.1741 -0.201 0 name "Panel_0_0" colorPlaca 0.92 0.92 0.92 controller "panel_dataset" supervisor TRUE }
DEF PANEL_0_1 sofia { translation -0.1741 -0.067 0 name "Panel_0_1" colorPlaca 0.92 0.92 0.92 controller "panel_dataset" supervisor TRUE }
DEF PANEL_0_2 sofia { translation -0.1741 0.067 0 name "Panel_0_2" colorPlaca 0.92 0.92 0.92 controller "panel_dataset" supervisor TRUE }
DEF PANEL_0_3 sofia { translation -0.1741 0.201 0 name "Panel_0_3" colorPlaca 0.92 0.92 0.92 controller "panel_dataset" supervisor TRUE }
DEF PANEL_1_0 sofia { translation -0.0580 -0.134 0 name "Panel_1_0" colorPlaca 0.92 0.92 0.92 controller "panel_dataset" supervisor TRUE }
DEF PANEL_1_1 sofia { translation -0.0580 0.000 0 name "Panel_1_1" colorPlaca 0.92 0.92 0.92 controller "panel_dataset" supervisor TRUE }
DEF PANEL_1_2 sofia { translation -0.0580 0.134 0 name "Panel_1_2" colorPlaca 0.92 0.92 0.92 controller "panel_dataset" supervisor TRUE }
DEF PANEL_1_3 sofia { translation -0.0580 0.268 0 name "Panel_1_3" colorPlaca 0.92 0.92 0.92 controller "panel_dataset" supervisor TRUE }
DEF PANEL_2_0 sofia { translation 0.0580 -0.201 0 name "Panel_2_0" colorPlaca 0.92 0.92 0.92 controller "panel_dataset" supervisor TRUE }
DEF PANEL_2_1 sofia { translation 0.0580 -0.067 0 name "Panel_2_1" colorPlaca 0.92 0.92 0.92 controller "panel_dataset" supervisor TRUE }
DEF PANEL_2_2 sofia { translation 0.0580 0.067 0 name "Panel_2_2" colorPlaca 0.92 0.92 0.92 controller "panel_dataset" supervisor TRUE }
DEF PANEL_2_3 sofia { translation 0.0580 0.201 0 name "Panel_2_3" colorPlaca 0.92 0.92 0.92 controller "panel_dataset" supervisor TRUE }
DEF PANEL_3_0 sofia { translation 0.1741 -0.134 0 name "Panel_3_0" colorPlaca 0.92 0.92 0.92 controller "panel_dataset" supervisor TRUE }
DEF PANEL_3_1 sofia { translation 0.1741 0.000 0 name "Panel_3_1" colorPlaca 0.92 0.92 0.92 controller "panel_dataset" supervisor TRUE }
DEF PANEL_3_2 sofia { translation 0.1741 0.134 0 name "Panel_3_2" colorPlaca 0.92 0.92 0.92 controller "panel_dataset" supervisor TRUE }
DEF PANEL_3_3 sofia { translation 0.1741 0.268 0 name "Panel_3_3" colorPlaca 0.92 0.92 0.92 controller "panel_dataset" supervisor TRUE }


# =============================================
# DATASET DEL DIAGNÓSTICO DE ALINEACIÓN
# (generado por Alignment/build/herramientas/crear_mundo_dataset.py)
# =============================================

DEF LUZ_DIRECCIONAL DirectionalLight {
  direction -1 -1 -1
  intensity 1
  castShadows TRUE
}

DEF LUZ_PUNTUAL PointLight {
  location 0.3 0.3 0.5
  intensity 2
  attenuation 0 0 1
}

# Marco: 4 marcadores ArUco a la altura de las placas
Solid {
  translation 0.3000 0.3335 0.0580
  children [
    Shape {
      appearance PBRAppearance {
        baseColorMap ImageTexture { url [ "textures/aruco_0.png" ] filtering 0 }
        roughness 1
        metalness 0
      }
      geometry Box { size 0.080 0.080 0.002 }
    }
    Transform {
      translation 0 0 -0.0290
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.3 0.3 0.3 roughness 1 metalness 0 }
          geometry Box { size 0.02 0.02 0.0560 }
        }
      ]
    }
  ]
  name "aruco_0"
}

