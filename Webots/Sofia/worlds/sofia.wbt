#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "../protos/sofia.proto"

WorldInfo {
  basicTimeStep 8
  coordinateSystem "ENU"
}

Viewpoint {
  position 0.6 0.6 0.5
  orientation -0.35 0.65 0.7 1.5
  fieldOfView 0.9
}

TexturedBackground {}
TexturedBackgroundLight {}

Solid {
  translation 0 0 -0.005
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.7 0.7 0.7 roughness 1 }
      geometry Box { size 1 1 0.01 }
    }
  ]
  name "Suelo"
  boundingObject Box { size 1 1 0.01 }
}

# 16 unidades SOFIA (PROTO de protos/sofia.proto, del repo sofia-maquinas-estado).
# El origen de cada unidad está en el piso; la placa queda a ~59 mm.
# Separación mínima sin choques con TODAS las placas en su tope (±30°),
# medida sobre las mallas del PROTO: 140 mm entre vecinas de la misma
# fila y 116 mm entre filas (135.5 mm en diagonal), con ~3 mm de margen.
# Motores: joint_1 (eje X) = theta_1; joint_3 (eje Y, lleva la placa) = theta_2;
# joint_2 es la segunda biela y recibe el mismo ángulo que joint_3.
sofia { translation -0.174 -0.210 0 name "Panel_0_0" controller "tracker_esfera_cpp" supervisor TRUE }
sofia { translation -0.174 -0.070 0 name "Panel_0_1" controller "tracker_esfera_cpp" supervisor TRUE }
sofia { translation -0.174 0.070 0 name "Panel_0_2" controller "tracker_esfera_cpp" supervisor TRUE }
sofia { translation -0.174 0.210 0 name "Panel_0_3" controller "tracker_esfera_cpp" supervisor TRUE }
sofia { translation -0.058 -0.140 0 name "Panel_1_0" controller "tracker_esfera_cpp" supervisor TRUE }
sofia { translation -0.058 0.000 0 name "Panel_1_1" controller "tracker_esfera_cpp" supervisor TRUE }
sofia { translation -0.058 0.140 0 name "Panel_1_2" controller "tracker_esfera_cpp" supervisor TRUE }
sofia { translation -0.058 0.280 0 name "Panel_1_3" controller "tracker_esfera_cpp" supervisor TRUE }
sofia { translation 0.058 -0.210 0 name "Panel_2_0" controller "tracker_esfera_cpp" supervisor TRUE }
sofia { translation 0.058 -0.070 0 name "Panel_2_1" controller "tracker_esfera_cpp" supervisor TRUE }
sofia { translation 0.058 0.070 0 name "Panel_2_2" controller "tracker_esfera_cpp" supervisor TRUE }
sofia { translation 0.058 0.210 0 name "Panel_2_3" controller "tracker_esfera_cpp" supervisor TRUE }
sofia { translation 0.174 -0.140 0 name "Panel_3_0" controller "tracker_esfera_cpp" supervisor TRUE }
sofia { translation 0.174 0.000 0 name "Panel_3_1" controller "tracker_esfera_cpp" supervisor TRUE }
sofia { translation 0.174 0.140 0 name "Panel_3_2" controller "tracker_esfera_cpp" supervisor TRUE }
sofia { translation 0.174 0.280 0 name "Panel_3_3" controller "tracker_esfera_cpp" supervisor TRUE }

DEF ESFERA_TARGET Robot {
  translation 0 0 0.25
  name "esfera"
  controller "sofia_maestro_sim"
  customData "IDLE"
  supervisor TRUE
  children [
    Shape {
      appearance PBRAppearance { baseColor 1 0 0 roughness 0.2 }
      geometry Sphere { radius 0.006 }
    }
  ]
}

# Camara cenital: nodo propio que solo manda imagenes a la GUI (puerto 5556).
# Mira hacia abajo: arriba de la imagen = +X del mundo, derecha = -Y.
Robot {
  translation 0 0.035 0.85
  rotation 0 1 0 1.5708
  name "camara_cenital"
  controller "camara_sim"
  children [
    Camera {
      name "camara"
      fieldOfView 0.9
      width 320
      height 320
    }
  ]
}

PointLight { location 0.3 0.3 0.5 intensity 2 attenuation 0 0 1 }
DirectionalLight { direction -1 -1 -1 intensity 1 }
