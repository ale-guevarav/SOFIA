DEF ESFERA_TARGET Robot {
  translation 0 0 0.25
  name "esfera"
  controller "sofia_maestro_sim"
  customData "IDLE"
  supervisor TRUE
  children [
    Shape {
      appearance PBRAppearance { baseColor 1 0 0 roughness 0.2 }
      geometry Sphere { radius 0.006 }
    }
  ]
}

# Camara cenital: nodo propio que solo manda imagenes a la GUI (puerto 5556).
# Mira hacia abajo: arriba de la imagen = +X del mundo, derecha = -Y.
Robot {
  translation 0 0.035 0.85
  rotation 0 1 0 1.5708
  name "camara_cenital"
  controller "camara_sim"
  children [
    Camera {
      name "camara"
      fieldOfView 0.9
      width 320
      height 320
    }
  ]
}

PointLight { location 0.3 0.3 0.5 intensity 2 attenuation 0 0 1 }
DirectionalLight { direction -1 -1 -1 intensity 1 }
